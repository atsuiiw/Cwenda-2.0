# Copy to .env (next to compose.yaml) and change both secrets. .env is git-ignored.

# Password for the cwenda database user inside the db container
POSTGRES_PASSWORD=change-me

# 8+ characters. Encrypts the saved MyCourseVille login inside the app container.
# Changing it later makes the saved MCV login unreadable: just log in to MCV again.
MCV_STORAGE_PASSPHRASE=change-me-too

# Port on this computer (http://localhost:APP_PORT). Change it if 8000 is taken,
# e.g. by `npm run dev` in backend/.
APP_PORT=8000
